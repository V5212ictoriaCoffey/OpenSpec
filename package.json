{
  "name": "openspec",
  "version": "0.1.0",
  "description": "OpenSpec — A fork of Fission-AI/OpenSpec for generating and validating API specifications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "clean": "rm -rf dist",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "openapi",
    "openspec",
    "api",
    "specification",
    "typescript",
    "schema"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-v8": "^1.2.1",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openspec/openspec.git"
  },
  "volta": {
    "node": "20.11.0"
  },
  "packageManager": "npm@10.2.4",
  "_note": "Personal fork for learning — upstream: https://github.com/Fission-AI/OpenSpec"
}
